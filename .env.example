# copy to .env.dev and fill in — .env.* is gitignored
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# must be this exact name — langchain-huggingface reads it
HUGGINGFACEHUB_API_TOKEN=
# optional: tracing at https://smith.langchain.com
# only set TRACING=true once API_KEY is filled in, or every run 401s
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=genai-learning
